# Copy to .env.local and fill in. .env* is gitignored.

# --- AI provider ---------------------------------------------------------
# 'vertex' (production) or 'gemini' (API key, quick local work).
# Leave unset and it picks vertex automatically when a project is configured.
AI_PROVIDER=vertex

# Vertex AI. No key lives in this repo — auth is Application Default Credentials:
#   local dev:  gcloud auth application-default login
#   production: GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
#               (service account needs the 'Vertex AI User' role)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
VERTEX_LOCATION=global

# Only needed when AI_PROVIDER=gemini.
GEMINI_API_KEY=
# Benchmarked winner: cheapest and fastest with no quality loss on our tasks.
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional per-task overrides, if one step needs a bigger model.
# GEMINI_MODEL_PARSE=
# GEMINI_MODEL_BRIEFING=
# GEMINI_MODEL_DRAFT=

# Multiplier applied to our raw model cost to produce Hunter Usage.
HUNTER_USAGE_MARKUP=3

# --- Database ---------------------------------------------------------------
# Use 127.0.0.1, not localhost: on Windows 'localhost' resolves to IPv6 ::1
# first while MongoDB binds IPv4, which makes every query hang.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=jobhunting

# --- Sessions ---------------------------------------------------------------
# Signs the session cookie. Required in production; generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Gmail (Outreach) -------------------------------------------------------
# Create an OAuth 2.0 Client ID of type 'Web application' in Google Cloud
# Console -> APIs & Services -> Credentials, on the same project.
# Authorised redirect URI must be exactly:
#   http://localhost:3000/api/gmail/callback   (and your production URL)
# The consent screen needs the gmail.readonly and gmail.send scopes. While the
# app is unverified, only accounts added as Test Users can connect.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Encrypts stored Gmail tokens at rest. Falls back to SESSION_SECRET if unset.
TOKEN_ENCRYPTION_KEY=

# --- Job sources -----------------------------------------------------------
# YC, Wellfound and the ATS boards need no credentials.
#
# Indeed blocks direct crawling (403 + bot challenge) and their Terms prohibit
# it, so that source stays off until you have an official partner key.
# Apply at https://developer.indeed.com
INDEED_API_KEY=
INDEED_API_URL=

# Which company ATS boards to sweep, as vendor:slug pairs.
# Vendors: greenhouse | lever | ashby | smartrecruiters
ATS_BOARDS=greenhouse:stripe,ashby:ramp,lever:leverdemo

# --- Crawler manners -------------------------------------------------------
# Minimum gap between requests to the same host, in ms.
CRAWLER_MIN_INTERVAL_MS=1000
# Advertised in the User-Agent so site owners can reach you.
CRAWLER_CONTACT_URL=https://jobhunting.app/bot

# --- Metadata --------------------------------------------------------------
# Production origin; resolves relative Open Graph image URLs.
NEXT_PUBLIC_SITE_URL=
